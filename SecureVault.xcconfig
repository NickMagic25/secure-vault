// Shared signing settings for the secure-vault executable target.
// Put machine-specific values in SecureVault.local.xcconfig.

PRODUCT_BUNDLE_IDENTIFIER = io.securevault
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = SecureVault.entitlements
ENABLE_HARDENED_RUNTIME = YES

// Optional local overrides. This file is intentionally gitignored.
#include? "SecureVault.local.xcconfig"
